# Copy to .env and fill in. Never commit .env.

# PostgreSQL password used by the db and odoo containers.
POSTGRES_PASSWORD=

# Host port where Odoo is published. Change it (and ODOO_URL) if 8069 is taken.
ODOO_PORT=8069

# Odoo connection used by the API. Inside docker compose the api service
# overrides ODOO_URL with http://odoo:8069.
ODOO_URL=http://localhost:8069
ODOO_DB=demo
ODOO_USERNAME=ai_assistant
# Filled in by scripts/init_odoo.sh.
ODOO_API_KEY=

# LLM (LiteLLM model string "<provider>/<model>")
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=
# Optional: low | medium | high
# LLM_REASONING_EFFORT=low
# Retries with backoff on rate limits and provider overload.
LLM_NUM_RETRIES=2

# Agent limits
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=60
CONVERSATION_TTL_SECONDS=3600
# Quotation drafts expire if not confirmed within this time.
DRAFT_TTL_SECONDS=900

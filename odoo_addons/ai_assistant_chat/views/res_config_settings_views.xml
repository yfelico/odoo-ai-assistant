<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_assistant_chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="ai_assistant_api" string="AI Assistant"
                         help="Connection to the AI assistant API used by the chat in the top bar">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="ai_assistant_api_url" class="col-lg-4 o_light_label"/>
                            <field name="ai_assistant_api_url" placeholder="http://api:8000"/>
                        </div>
                        <div class="row">
                            <label for="ai_assistant_api_token" class="col-lg-4 o_light_label"/>
                            <field name="ai_assistant_api_token" password="True"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
